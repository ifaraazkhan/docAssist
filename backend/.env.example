# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Auth ──
JWT_SECRET=change-me-to-a-random-64-char-string

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_TOKEN=your-meta-access-token
PHONE_NUMBER_ID=your-meta-phone-number-id
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
APP_SECRET=your-meta-app-secret

# ── Frontend URL (for magic links, CORS) ──
APP_URL=https://drcliniq.vercel.app
ALLOWED_ORIGINS=https://drcliniq.vercel.app

# ── Razorpay ──
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# ── Optional ──
# PORT=4000
# NODE_ENV=production
# ADMIN_EMAIL=admin@drcliniq.in
# ADMIN_PASSWORD=change-me
